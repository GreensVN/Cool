local updateLibraryList
updateLibraryList = function()
    for _, v in pairs(libScroll:GetChildren()) do
        if v:IsA("Frame") then v:Destroy() end
    end
    local query = searchBox.Text:lower()
    local count = 0
    for _, data in ipairs(scriptLibrary) do
        local matchCat = (currentSelCat == "Tất cả") or (data.category == currentSelCat)
        local matchSearch = (data.name:lower():find(query) or data.desc:lower():find(query))
        local matchFav = (not showFavOnly) or (favScripts[data.name] == true)
        if matchCat and matchSearch and matchFav then
            createScriptCard(data).Parent = libScroll
            count = count + 1
        end
    end
    scriptCountLabel.Text = "🌟 Số lượng script: " .. count .. " / " .. #scriptLibrary .. " | Right-click tên để xem mã!"
end
searchBox:GetPropertyChangedSignal("Text"):Connect(updateLibraryList)
updateLibraryList()

