local function isPossibleAdmin(p)
    if not p then return false end
    local name = (p.Name or ""):lower()
    local display = ((p.DisplayName or ""):lower())
    if name:find("admin") or name:find("mod") or name:find("dev") or name:find("staff")
    or display:find("admin") or display:find("mod") or display:find("dev") or display:find("staff") then
        return true, "Tên chứa từ khóa admin/mod/dev/staff"
    end
    if type(p.UserId) == "number" and p.UserId < 1000000 then return true, "UserId nhỏ (có thể staff/dev)" end

    -- Safe group/rank checks
    local groups = {1200769, 2868472, 5708463, 1}
    for _, gid in ipairs(groups) do
        local ok, rank = pcall(function() return p:GetRankInGroup(gid) end)
        if ok and type(rank) == "number" and rank >= 200 then return true, "Rank nhóm cao" end
    end
    return false
end

