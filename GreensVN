        if setclipboard then
            setclipboard(string.format("loadstring(game:HttpGet('%s'))()", data.url))
        end
        copyTip.Text = "✓ Đã copy đoạn Code!"
        task.wait(1.5)
        copyTip.Text = "Click = Run | Hold = Copy Link | Right-Click = Copy Code"
    end)

    return card
