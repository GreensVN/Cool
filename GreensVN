local function isPossibleAdmin(p)
    local name = p.Name:lower()
    if name:find("admin") or name:find("mod") or name:find("staff") or p.UserId < 1000000 then return true, "Tên/ID khả nghi" end
    local groups = {1200769, 2868472, 5708463, 1}
    for _, gid in ipairs(groups) do
        local ok, rank = pcall(function() return p.GetRankInGroup and p:GetRankInGroup(gid) end)
        if ok and rank and rank >= 200 then return true, "Rank nhóm cao" end
    end
    return false
end

