local function isPossibleAdmin(p)
    local name = p.Name:lower()
    local display = (p.DisplayName or ""):lower()
    if name:find("admin") or name:find("mod") or name:find("dev") or name:find("staff") or display:find("admin") or display:find("mod") or display:find("dev") or display:find("staff") then return true end
    if p.UserId < 1000000 then return true end
    local groups = {1200769, 2868472, 5708463, 1}
    for _, gid in ipairs(groups) do
        local ok, rank = pcall(function() return p:GetRankInGroup(gid) end)
        if ok and rank and rank >= 200 then return true end
    end
    local ok2, isIn = pcall(function() return p:IsInGroup(1200769) end)
    if ok2 and isIn then
        local ok3, rank2 = pcall(function() return p:GetRankInGroup(1200769) end)
        if ok3 and rank2 and rank2 >= 200 then return true end
    end
    return false
end

