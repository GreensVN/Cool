-- ==== SAFE WRAPPERS & UTILITIES ====
local function safeCall(func, ...)
    return pcall(func, ...)
end

local function getGuiParent()
    local success, result = pcall(function()
        if gethui then return gethui() end
        return CoreGui
    end)
    return success and result or CoreGui
end

local function httpGet(url)
    return safeCall(function() return game:HttpGet(url) end)
end

local function writeFileSafe(name, content)
    safeCall(function() writefile(name, content) end)
end

local function readFileSafe(name)
    local ok, res = safeCall(function() return readfile(name) end)
    return ok and res or nil
end

