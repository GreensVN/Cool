-- ==== STEALTH & ADMIN DETECT SYSTEM ====
local stealthMode = false
local adminDetectMode = false
local STEALTH_CONNECTIONS, ADMIN_CONNECTIONS = {}, {}
local ADMINS_DETECTED = false

local function activateStealth()
    pcall(function()
        for _,v in pairs({"syn","is_synapse_function","isexecutorclosure","fluxus","get_hidden_gui","gethui","getgenv","getrawmetatable"}) do
            if getgenv()[v] then getgenv()[v] = nil end
        end
    end)
    pcall(function()
        if setreadonly and getrawmetatable then
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local oldNamecall = mt.__namecall
            mt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod and getnamecallmethod() or ""
                if tostring(self):lower():find("report") or tostring(self):lower():find("log") then return end
                return oldNamecall(self, ...)
            end)
            setreadonly(mt, true)
        end
    end)
    pcall(function()
        for _,c in ipairs(STEALTH_CONNECTIONS) do pcall(function() c:Disconnect() end) end
        STEALTH_CONNECTIONS = {}
        table.insert(STEALTH_CONNECTIONS, UserInputService.WindowFocusReleased:Connect(function()
            for _,obj in pairs(getGuiParent():GetChildren()) do
                if obj:IsA("ScreenGui") and obj.Name:lower():find("greensvn") then obj.Enabled = false end
            end
        end))
        table.insert(STEALTH_CONNECTIONS, UserInputService.WindowFocused:Connect(function()
            for _,obj in pairs(getGuiParent():GetChildren()) do
                if obj:IsA("ScreenGui") and obj.Name:lower():find("greensvn") then obj.Enabled = true end
            end
        end))
    end)
end

local function deactivateStealth()
    for _,c in ipairs(STEALTH_CONNECTIONS) do pcall(function() c:Disconnect() end) end
    STEALTH_CONNECTIONS = {}
end

local function isPossibleAdmin(p)
    local name = p.Name:lower()
    if name:find("admin") or name:find("mod") or name:find("staff") or name:find("dev") then return true end
    if p.UserId < 1000000 then return true end
    return false
end

local function activateAdminDetect()
    for _,c in ipairs(ADMIN_CONNECTIONS) do pcall(function() c:Disconnect() end) end
    ADMIN_CONNECTIONS = {}
    for _,p in pairs(Players:GetPlayers()) do
        if p ~= player and isPossibleAdmin(p) then
            ADMINS_DETECTED = true
        end
    end
    table.insert(ADMIN_CONNECTIONS, Players.PlayerAdded:Connect(function(p)
        if p ~= player and isPossibleAdmin(p) then
            ADMINS_DETECTED = true
            screenGui.Enabled = false
        end
    end))
    table.insert(ADMIN_CONNECTIONS, Players.PlayerRemoving:Connect(function(p)
        if p ~= player and isPossibleAdmin(p) then
            task.wait(1)
            local anyAdmin = false
            for _,pl in pairs(Players:GetPlayers()) do
                if pl ~= player and isPossibleAdmin(pl) then anyAdmin = true break end
            end
            if not anyAdmin then
                ADMINS_DETECTED = false
                screenGui.Enabled = true
            end
        end
    end))
end

local function deactivateAdminDetect()
    for _,c in ipairs(ADMIN_CONNECTIONS) do pcall(function() c:Disconnect() end) end
    ADMIN_CONNECTIONS = {}
    ADMINS_DETECTED = false
    screenGui.Enabled = true
end

