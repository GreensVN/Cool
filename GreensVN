local function activateAdminDetect()
    -- cleanup old
    for _,c in ipairs(ADMIN_CONNECTIONS) do pcall(function() c:Disconnect() end) end
    ADMIN_CONNECTIONS = {}

    -- initial scan
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local ok, reason = pcall(isPossibleAdmin, p)
            if ok and reason then
                ADMINS_DETECTED = true
                if screenGui then screenGui.Enabled = false end
                showAdminPopup("Phát hiện Admin: "..p.Name.."\n"..tostring(reason))
            end
        end
    end

    table.insert(ADMIN_CONNECTIONS, Players.PlayerAdded:Connect(function(p)
        if p ~= player then
            local ok, reason = pcall(isPossibleAdmin, p)
            if ok and reason then
                ADMINS_DETECTED = true
                if screenGui then screenGui.Enabled = false end
                showAdminPopup("Admin vừa vào: "..p.Name.."\n"..tostring(reason))
            end
        end
    end))

    table.insert(ADMIN_CONNECTIONS, Players.PlayerRemoving:Connect(function(p)
        if p ~= player then
            local ok, isAdm = pcall(isPossibleAdmin, p)
            if ok and isAdm then
                task.wait(1)
                local anyAdmin = false
                for _,pl in ipairs(Players:GetPlayers()) do
                    if pl ~= player then
                        local ok2, isA = pcall(isPossibleAdmin, pl)
                        if ok2 and isA then anyAdmin = true break end
                    end
                end
                if not anyAdmin then
                    ADMINS_DETECTED = false
                    if screenGui then screenGui.Enabled = true end
                    showAdminPopup("Admin đã rời - Hub hiển thị lại")
                end
            end
        end
    end))
end

local function deactivateAdminDetect()
    for _,c in ipairs(ADMIN_CONNECTIONS) do pcall(function() c:Disconnect() end) end
    ADMIN_CONNECTIONS = {}
    ADMINS_DETECTED = false
    if screenGui then screenGui.Enabled = true end
end

local function activateStealth()
    stealthMode = true
    -- hide GUIs on focus lost
    for _,c in ipairs(STEALTH_CONNECTIONS) do pcall(function() c:Disconnect() end) end
    STEALTH_CONNECTIONS = {}
    table.insert(STEALTH_CONNECTIONS, UserInputService.WindowFocusReleased:Connect(function()
        for _,g in ipairs(getGuiParent():GetChildren()) do
            if g:IsA("ScreenGui") and tostring(g.Name):lower():find("greensvn") then
                pcall(function() g.Enabled = false end)
            end
        end
    end))
    table.insert(STEALTH_CONNECTIONS, UserInputService.WindowFocused:Connect(function()
        for _,g in ipairs(getGuiParent():GetChildren()) do
            if g:IsA("ScreenGui") and tostring(g.Name):lower():find("greensvn") then
                pcall(function() g.Enabled = true end)
            end
        end
    end))
    -- best-effort hook Kick
    pcall(function()
        if player and player.Kick then
            safeHookFunction(player.Kick, function() return end)
        end
    end)
end

local function deactivateStealth()
    stealthMode = false
    for _,c in ipairs(STEALTH_CONNECTIONS) do pcall(function() c:Disconnect() end) end
    STEALTH_CONNECTIONS = {}
    -- re-enable GUIs
    for _,g in ipairs(getGuiParent():GetChildren()) do
        if g:IsA("ScreenGui") and tostring(g.Name):lower():find("greensvn") then
            pcall(function() g.Enabled = true end)
        end
    end
end

