                            runBtn.Text = "✓ OK"; runBtn.BackgroundColor3 = Color3.fromRGB(40,200,120)
                            task.wait(1); runBtn.Text = "▶ Run"; runBtn.BackgroundColor3 = Color3.fromRGB(90,220,140)
                        else
                            runBtn.Text = "✗ Err"; runBtn.BackgroundColor3 = Color3.fromRGB(200,40,60)
                            task.wait(1.2); runBtn.Text = "▶ Run"; runBtn.BackgroundColor3 = Color3.fromRGB(90,220,140)
                        end
                    end)
                end)
                table.insert(entries, card)
            end
        end
    end

    search:GetPropertyChangedSignal("Text"):Connect(refreshLib)
    refreshLib()
end

