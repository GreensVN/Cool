        holdStart = tick()
        task.spawn(function()
            task.wait(0.4)
            if holding then
                if setclipboard then setclipboard(data.url) end
                copyTip.Text = "✓ Đã copy Link!"
                task.wait(1.5)
                copyTip.Text = "Click = Run | Hold = Copy Link | Right-Click = Copy Code"
            end
        end)
    end)

    libBtn.MouseButton1Up:Connect(function()
