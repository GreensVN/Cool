-- ==== TAB LOGIC & ANIMATIONS ====
local function showTab(idx)
    for i, frame in ipairs(tabFrames) do
        if i == idx then
            frame.Visible = true
            frame.Position = UDim2.new(0, TAB_WIDTH + 20, 0, 64)
            TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Position = UDim2.new(0, TAB_WIDTH, 0, 64)}):Play()
        else
            frame.Visible = false
        end
        TweenService:Create(tabBtns[i], TweenInfo.new(0.15), {
            BackgroundColor3 = (i==idx) and Color3.fromRGB(64, 110, 64) or Color3.fromRGB(55, 55, 65)
        }):Play()
    end
end

for i, btn in ipairs(tabBtns) do
    btn.MouseButton1Click:Connect(function() showTab(i) end)
    btn.MouseEnter:Connect(function()
        if not tabFrames[i].Visible then
            TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(90, 170, 120)}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if not tabFrames[i].Visible then
            TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(55, 55, 65)}):Play()
        end
    end)
end

-- ==== DRAG & RESIZE LOGIC ====
local dragging, dragInput, dragStart, startPos
topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

