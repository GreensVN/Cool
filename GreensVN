local function createToggle(parent, name, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, -4, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
    btn.Text = name..": OFF"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0.3, 0)
    local state = false
    btn.MouseButton1Click:Connect(function()
        playClickSound()
        state = not state
        btn.Text = name..": "..(state and "ON" or "OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(60, 180, 80) or Color3.fromRGB(180, 60, 60)
        callback(state)
    end)
    return btn
end

