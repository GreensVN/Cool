local player = Players.LocalPlayer or Players:FindFirstChildOfClass("Player") -- best-effort
local function getGuiParent()
    local ok, res = pcall(function() if type(gethui) == "function" then return gethui() end return CoreGui end)
    return ok and res or CoreGui
end

local function safeHttpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    return ok and res or nil
end

local function safeLoadUrl(url)
    local str = safeHttpGet(url)
    if not str then return false, "HttpGet failed" end
    local ok, fn = pcall(function() return loadstring(str) end)
    if not ok or type(fn) ~= "function" then return false, "loadstring failed" end
    local suc, err = pcall(fn)
    return suc, err
end

-- Short safe wrappers for executor-specific APIs
local function safeHookFunction(target, newfn)
    if type(target) ~= "function" then return false end
    local ok, _ = pcall(function() if hookfunction then hookfunction(target, newfn) end end)
    return ok
end

local function safeGetConnections(obj)
    local ok, conns = pcall(function() if getconnections then return getconnections(obj) end end)
    return ok and (conns or {}) or {}
end

