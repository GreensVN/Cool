            local isAdm, reason = isPossibleAdmin(p)
            if isAdm then
                ADMINS_DETECTED = true
                if screenGui then screenGui.Enabled = false end
                showAdminPopup("Admin vừa vào ("..p.Name..")\nLý do: "..reason)
            end
        end
    end))
    table.insert(ADMIN_CONNECTIONS, Players.PlayerRemoving:Connect(function(p)
        if p ~= player then
            local isAdm, _ = isPossibleAdmin(p)
            if isAdm then
                task.wait(1)
